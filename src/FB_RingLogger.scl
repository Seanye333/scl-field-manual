FUNCTION_BLOCK "FB_RingLogger"
{ S7_Optimized_Access := 'TRUE' }
// Timestamped ring buffer of the last 100 samples with statistics.
// Import UDT_LogEntry first.
VAR_INPUT
    sample  : Real;
    trigger : Bool;        // rising edge stores one entry
END_VAR
VAR_OUTPUT
    count  : Int;          // entries stored (saturates at 100)
    newest : Int;          // index of the most recent entry
    minVal : Real;
    maxVal : Real;
    avgVal : Real;
END_VAR
VAR
    buf  : Array[0..99] of "UDT_LogEntry";
    next : Int;
    trig : R_TRIG;
END_VAR
VAR_TEMP
    i   : Int;
    sum : Real;
    ret : Int;
    now : DTL;
END_VAR

BEGIN
    #trig(CLK := #trigger);
    IF #trig.Q THEN
        #ret := RD_LOC_T(OUT => #now);     // CPU local time
        #buf[#next].stamp := #now;
        #buf[#next].value := #sample;
        #newest := #next;
        #next := (#next + 1) MOD 100;      // the ring
        IF #count < 100 THEN
            #count := #count + 1;
        END_IF;

        // Statistics only when an entry lands - event-driven
        #sum := 0.0;
        #minVal := #buf[0].value;
        #maxVal := #buf[0].value;
        FOR #i := 0 TO #count - 1 DO
            #sum    := #sum + #buf[#i].value;
            #minVal := MIN(IN1 := #minVal, IN2 := #buf[#i].value);
            #maxVal := MAX(IN1 := #maxVal, IN2 := #buf[#i].value);
        END_FOR;
        #avgVal := #sum / INT_TO_REAL(#count);
    END_IF;
END_FUNCTION_BLOCK
